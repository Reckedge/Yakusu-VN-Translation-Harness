{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yakusoku",
  "version": "0.2.0",
  "identifier": "io.github.reckedge.yakusoku",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Yakusoku",
        "width": 1240,
        "height": 820,
        "minWidth": 860,
        "minHeight": 600,
        "backgroundColor": "#161827",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Translate Japanese visual novels into English patches",
    "longDescription": "Pick a game folder, paste an API key, get an installable English patch. Every change can be undone.",
    "copyright": "Reckedge. GPL-3.0-or-later.",
    "licenseFile": "../LICENSE",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "resources": { "../tools/": "tools/" },
    "windows": {
      "nsis": { "installMode": "currentUser", "installerIcon": "icons/icon.ico" }
    }
  }
}
